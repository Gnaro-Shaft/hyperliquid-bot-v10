# Sauvegarde de l'archive Parquet — à installer sur homeserv03, à côté du
# watchdog externe, pas sur le VPS. (Elle vivait sur homeserv02, mort le
# 16/09/2026 avec la seule copie de l'archive.)
#
# C'est la sauvegarde qui TIRE, jamais le VPS qui pousse : le VPS est la machine
# exposée à Internet. Une compromission de la sauvegarde ne donne alors qu'un
# accès en lecture seule au répertoire d'archive — jamais au .env ni aux clés de
# trading. La clé est verrouillée côté VPS par
# command="/usr/bin/rrsync -ro /opt/v10/data/parquet",restrict
#
# Pas de --delete : la sauvegarde n'accumule et ne met à jour que. Une
# suppression accidentelle côté VPS ne peut pas se propager ici.
[Unit]
Description=Sauvegarde de l'archive Parquet V10 depuis le VPS
After=network-online.target
Wants=network-online.target
# L'alerte immédiate d'un échec, sans attendre les 48 h du contrôle de fraîcheur.
OnFailure=v10-alert-watchdog@%n.service

[Service]
Type=oneshot
# L'adresse du VPS vit hors du dépôt : /etc/default/v10-archive-pull
# contient VPS_HOST=<ip ou nom d'hôte>.
EnvironmentFile=/etc/default/v10-archive-pull
# Hors de /var/lib/vz : Proxmox tiendrait le répertoire pour son stockage
# `local` et pourrait l'élaguer. Le répertoire doit rester lisible : le
# watchdog, sous v10watch, y lit le marqueur. (Inutile de restreindre parquet/ :
# rsync -a lui rend les droits de la source au premier passage.)
ExecStartPre=/bin/mkdir -p /var/backups/v10-archive/parquet
# --no-owner --no-group : botv10 n'existe pas ici, et son UID (999) y est celui
# de v10watch — rsync -a lui confiait l'archive. Constaté au premier passage,
# le 25/09/2026. Tout appartient à root.
ExecStart=/usr/bin/rsync -a --no-owner --no-group --info=stats1 \
    -e "ssh -i /root/.ssh/v10_archive -o BatchMode=yes -o ConnectTimeout=20" \
    v10archive@${VPS_HOST}:/ /var/backups/v10-archive/parquet/
# Marqueur horodaté, lu par le watchdog (BACKUP_MARKER). ExecStartPost ne
# s'exécute que si rsync a réussi : le marqueur ne ment pas.
ExecStartPost=/bin/sh -c 'date +%%s > /var/backups/v10-archive/.derniere_sauvegarde'
SyslogIdentifier=v10-archive-pull
